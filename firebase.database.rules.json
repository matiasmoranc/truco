{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".read": "auth != null",
      "$room": {
        "public": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "hands": {
      "$room": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && (auth.uid == $uid || auth.uid == root.child('rooms').child($room).child('public').child('table').child('uid').val())"
        }
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "name": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-zÁÉÍÓÚÜÑáéíóúüñ0-9._-]{1,18}$/) && newData.parent().parent().parent().child('usernames').child(newData.val().toLowerCase().replace('.', '%2E')).val() == auth.uid"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "usernames": {
      "$key": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.val() == auth.uid) || (data.val() == auth.uid && (newData.val() == auth.uid || (!newData.exists() && newData.parent().parent().child('profiles').child(auth.uid).child('name').val().toLowerCase().replace('.', '%2E') != $key))))",
        ".validate": "newData.isString() && newData.val() == auth.uid && newData.parent().parent().child('profiles').child(auth.uid).child('name').val().toLowerCase().replace('.', '%2E') == $key"
      }
    }
  }
}
