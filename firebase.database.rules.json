{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".read": "auth != null",
      "$room": {
        "public": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "hands": {
      "$room": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && (auth.uid == $uid || auth.uid == root.child('rooms').child($room).child('public').child('table').child('uid').val())"
        }
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid && root.child('usernameIndexReady').val() == true",
        "name": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-zÁÉÍÓÚÜÑáéíóúüñ0-9._-]{1,18}$/) && newData.parent().parent().parent().child('usernames').child(newData.val().toLowerCase().replace('.', '%2E')).val() == auth.uid"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "usernames": {
      "$key": {
        ".read": "auth != null",
        ".write": "root.child('usernameIndexReady').val() == true && (auth != null && ((!data.exists() && newData.val() == auth.uid) || (data.val() == auth.uid && (newData.val() == auth.uid || (!newData.exists() && newData.parent().parent().child('profiles').child(auth.uid).child('name').val().toLowerCase().replace('.', '%2E') != $key)))))",
        ".validate": "newData.isString() && newData.val() == auth.uid && newData.parent().parent().child('profiles').child(auth.uid).child('name').val().toLowerCase().replace('.', '%2E') == $key"
      }
    },
    "usernameIndexReady": {
      ".read": "auth != null",
      ".write": false
    },
    "creditEconomy": {
      ".read": false,
      ".write": false,
      "wallets": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid && (auth.token.firebase.sign_in_provider == 'google.com' || auth.token.firebase.sign_in_provider == 'apple.com') && root.child('profiles').child($uid).child('name').isString() && newData.exists() && ((!data.exists()) || (data.child('balance').val() == 0 && data.child('locked').val() == 0 && data.child('lastGrantAt').val() < now - ((now - 10800000) % 86400000))) && newData.child('balance').val() == 2 && newData.child('locked').val() == 0 && newData.child('lastGrantAt').val() == now",
          ".validate": "newData.hasChildren(['balance', 'locked', 'lastGrantAt'])",
          "balance": {
            ".validate": "newData.isNumber() && newData.val() == 2"
          },
          "locked": {
            ".validate": "newData.isNumber() && newData.val() == 0"
          },
          "lastGrantAt": {
            ".validate": "newData.isNumber() && newData.val() == now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "matches": {
        ".read": false,
        ".write": false
      }
    }
  }
}
