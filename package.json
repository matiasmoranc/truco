{
  "name": "truco-uruguayo",
  "version": "1.0.0",
  "description": "Juego de Truco Uruguayo web y mobile",
  "scripts": {
    "mobile:build": "node scripts/build-mobile.cjs",
    "mobile:apk": "node scripts/build-android-test.cjs",
    "mobile:add:android": "npm run mobile:build && cap add android && npm run mobile:icons && node scripts/prepare-no-ads.cjs",
    "mobile:add:ios": "npm run mobile:build && cap add ios && npm run mobile:icons && node scripts/prepare-no-ads.cjs",
    "mobile:sync": "npm run mobile:build && cap sync && npm run mobile:icons && node scripts/prepare-no-ads.cjs",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "test": "node --test tests/*.cjs cloudflare/test/table-engine.test.js cloudflare/test/bank-core.test.js cloudflare/test/bank-mirror.test.js",
    "dev:web": "node scripts/serve-local.cjs",
    "mobile:icons": "node scripts/build-app-icons.cjs",
    "mobile:verify:no-ads": "node scripts/verify-no-ads.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matiasmoranc/truco.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/matiasmoranc/truco/issues"
  },
  "homepage": "https://github.com/matiasmoranc/truco#readme",
  "dependencies": {
    "@capacitor-firebase/authentication": "8.5.2",
    "@capacitor-firebase/messaging": "8.5.2",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3",
    "@capawesome/capacitor-app-update": "8.1.0",
    "firebase": "12.19.0"
  },
  "private": true,
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "sharp": "0.35.5",
    "vite": "7.3.7"
  }
}
