{
  "database": {
    "rules": "firebase.database.rules.json"
  },
  "hosting": {
    "public": ".",
    "headers": [
      {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate"}]},
      {"source": "**/*.html", "headers": [{"key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate"}]}
    ],
    "ignore": [
      "firebase.json",
      "gha-creds-*.json",
      "**/gha-creds-*.json",
      "DEPLOY.md",
      "ANUNCIOS.md",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "server/**",
      "cloudflare/**",
      "tests/**",
      "scripts/**",
      "CREDITOS.md",
      "firebase*.json",
      "android/**",
      "ios/**",
      "www/**",
      "mobile/**",
      "package*.json",
      "capacitor.config.json",
      "MOBILE.md",
      "publication/**",
      "README.md",
      "ADMIN.md",
      "GOOGLE-LOGIN.md",
      "*.patch",
      "*.log",
      "artifacts/**",
      "work/**",
      "outputs/**",
      "codemagic.yaml",
      "logs-*",
      "maqueta-*",
      "marketing/**",
      ".mobile-web/**",
      "assets/README.md",
      "assets/tatu-original.jpeg",
      "assets/tatu-sprite.webp",
      "assets/tatu-sprite-user.webp",
      "assets/tatu-dorso-user.webp",
      "assets/guia-truco.png",
      "assets/truco-uruguayo-v2.png",
      "assets/lobby-desktop-tatu.webp"
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  }
}
