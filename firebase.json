{
  "database": {
    "rules": "firebase.database.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "server/**",
      "tests/**",
      "scripts/**",
      "CREDITOS.md",
      "firebase*.json",
      "android/**",
      "ios/**",
      "www/**",
      "mobile/**",
      "package*.json",
      "capacitor.config.json",
      "MOBILE.md"
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  }
}
