{
  "database": {
    "rules": "firebase.database.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "server/**",
      "tests/**",
      "scripts/**",
      "CREDITOS.md",
      "firebase*.json"
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  }
}